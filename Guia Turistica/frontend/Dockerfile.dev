# Dockerfile.dev
FROM node:18-alpine

# Evita errores de permisos cuando npm genera node_modules
RUN mkdir -p /app && chown -R node:node /app

WORKDIR /app

# Usamos usuario node para evitar permisos root en node_modules
USER node

# Copiamos package.json primero para aprovechar el caching
COPY --chown=node:node package*.json ./

RUN npm install

# Luego copiamos el resto del código
COPY --chown=node:node . .

# Vite necesita exponer WebSocket además del puerto normal
EXPOSE 5137 5137/udp

# Arrancamos Vite correctamente
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5137"]

